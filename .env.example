# Copy to .env and fill in only the keys you actually need.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
#
# .env is git-ignored. NEVER commit real keys, and never paste one into a
# notebook, a note, or a committed config file.

# --- LLM providers ---------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings / models ---------------------------------------------------
HUGGINGFACEHUB_API_TOKEN=

# --- Reranking (section 07) ------------------------------------------------
COHERE_API_KEY=

# --- Web retrieval (section 18) --------------------------------------------
TAVILY_API_KEY=

# --- Tracing / observability (section 15) ----------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-learning-lab

# --- Local paths -----------------------------------------------------------
# Directories for generated indexes and downloaded corpora (both git-ignored).
VECTOR_STORE_DIR=./.vectorstores
DATA_DIR=./data
